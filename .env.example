# Supabase project (Project settings → API). The service role key is used on the
# server only and must never be exposed to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app on your own domain, used to build candidate links.
APP_BASE_URL=https://assessment.yourdomain.com

# Password for the recruiter dashboard (/admin) and a long random secret used to
# sign the admin session cookie.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=generate-a-long-random-string

# Address used by the candidate "Contact Recruiter" button when a link has no
# recruiter email of its own.
RECRUITER_EMAIL=recruitment@yourdomain.com

# Default time limit in minutes for new assessment links.
DEFAULT_TIME_LIMIT_MINUTES=5
