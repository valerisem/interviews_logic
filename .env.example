# Supabase project (Project settings → API). The service role key is used on the
# server only and must never be exposed to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this app. Candidates use <APP_BASE_URL>/form, admins <APP_BASE_URL>/admin;
# every other path redirects to REDIRECT_URL.
APP_BASE_URL=https://houseofmarketer.com
REDIRECT_URL=https://houseofmarketers.com

# Recruiter sign-in with Google. Create an OAuth client (type: Web application) in
# Google Cloud Console → APIs & Services → Credentials, with the authorised redirect URI
#   <APP_BASE_URL>/api/auth/google/callback
# Only houseofmarketers.com accounts can sign in, and only team members listed below.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Team ids (from public.team) allowed into the recruiter dashboard, comma-separated.
# 3 = Valeria Semibratnya.
ADMIN_TEAM_IDS=3

# Long random secret used to sign the recruiter session cookie.
ADMIN_SESSION_SECRET=generate-a-long-random-string
