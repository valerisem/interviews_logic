    {
      "id": "priorities",
      "title": "Company Priorities → Execution",
      "steps": [
        {
          "lane": "ceo",
          "who": "CEO",
          "tags": [
            "OWNS"
          ],
          "lines": [
            "Sets company priorities and major strategic direction"
